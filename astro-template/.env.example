# Per-site Astro frontend environment.
# Copy to `.env` (astro-init does this automatically) and fill in real values.
# `.env` is git-ignored — never commit secrets.

# WordPress backend origin serving the REST/headless API.
# Overrides site.config.ts `wp.baseUrl` at build time (e.g. point the build at
# a local Docker WP: http://localhost:8080). Leave blank to use site.config.ts.
WP_BASE_URL=

# Public origin of the built static site. Overrides site.config.ts `siteUrl`
# (used for canonical URLs / sitemap). Handy for staging builds.
PUBLIC_SITE_URL=

# Bearer token for the token-gated headless endpoints (raw post_content).
# Must match HEADLESS_API_TOKEN configured on the WordPress mu-plugin side.
HEADLESS_API_TOKEN=

# FTP deploy target (used by astro-core/scripts/deploy-static.sh via just astro-deploy).
FTP_HOST=
FTP_USER=
FTP_PASS=
# Remote docroot to mirror dist/ into, e.g. /domains/example.com/public_html
FTP_REMOTE_PATH=

# Local dev server port (host side); container maps this to 4321.
ASTRO_PORT=4321
