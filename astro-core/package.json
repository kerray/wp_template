{
  "name": "@site/astro-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Reusable Astro + UnoCSS headless-WordPress layer: data layer, content IR, adapters, base components and deploy tooling. Shipped as raw source (no build step) and consumed by sites via a file: symlink.",
  "exports": {
    "./ir": "./src/lib/content/ir.ts",
    "./adapters": "./src/lib/content/adapters/index.ts",
    "./loader": "./src/lib/loaders/wordpress-loader.ts",
    "./config": "./src/lib/config.ts",
    "./wordpress": "./src/lib/wordpress.ts",
    "./dates": "./src/lib/dates.ts",
    "./uno": "./uno.preset.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@wordpress/block-serialization-default-parser": "^5.50.0",
    "marked": "^18.0.6",
    "ultrahtml": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "astro": "^7.0.6",
    "typescript": "^6.0.3",
    "unocss": "^66.7.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "astro": ">=7",
    "unocss": ">=66"
  }
}
