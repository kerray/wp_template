# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
#
# CRITICAL: This is a TEMPLATE. You MUST change ALL passwords before deployment!
#
# Security checklist before deployment:
#   [ ] Changed MYSQL_ROOT_PASSWORD to a strong unique password (32+ chars)
#   [ ] Changed MYSQL_PASSWORD to a strong unique password (32+ chars)
#   [ ] Changed SFTP_PASSWORD or disabled SFTP entirely
#   [ ] Set WP_DEBUG=false
#   [ ] Verified phpMyAdmin/Adminer are NOT exposed to internet
#   [ ] Configured firewall to restrict database port access
#   [ ] Set up SSL/TLS termination (reverse proxy)
#
# Generate strong passwords with:
#   openssl rand -base64 32
#
# For detailed security guidance, see: docs/PRODUCTION_SECURITY.md
# =============================================================================

# -----------------------------------------------------------------------------
# Database Credentials - CHANGE THESE!
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_openssl_rand_base64_32
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_USE_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
# WordPress port (usually 80/443 behind reverse proxy, or 8080 direct)
WP_PORT=8080

# phpMyAdmin port - DO NOT expose to internet! Use SSH tunnel or VPN only
PMA_PORT=8081

# Adminer port - DO NOT expose to internet! Use SSH tunnel or VPN only
ADMINER_PORT=8082

# SFTP port - Consider disabling in production or using SSH keys only
SFTP_PORT=2222

# -----------------------------------------------------------------------------
# WordPress Configuration
# -----------------------------------------------------------------------------
# CRITICAL: Set to false in production!
WP_DEBUG=false

# WordPress table prefix (must match your database)
WORDPRESS_TABLE_PREFIX=wp_

# -----------------------------------------------------------------------------
# Development Tool Versions (locked for consistency)
# -----------------------------------------------------------------------------
COMPOSER_VERSION=2.7.1
WP_CLI_VERSION=2.11.0
WP_MCP_VERSION=0.2.3

# -----------------------------------------------------------------------------
# User/Group ID Mapping
# -----------------------------------------------------------------------------
# Match your host user for proper file permissions
# Find with: id -u && id -g
USER_ID=1000
GROUP_ID=1000

# -----------------------------------------------------------------------------
# SFTP Access - SECURE OR DISABLE
# -----------------------------------------------------------------------------
# Option 1: Disable SFTP entirely (recommended for production)
#   Don't use --profile sftp when starting containers
#
# Option 2: Use SSH key authentication (more secure)
#   Uncomment SSH key mount in docker-compose.fpm.yml and disable password
#   SFTP_PASSWORD=
#
# Option 3: Strong password (less secure, not recommended)
#   Generate with: openssl rand -base64 32
SFTP_PASSWORD=CHANGE_ME_OR_DISABLE_SFTP_IN_PRODUCTION

# -----------------------------------------------------------------------------
# Additional Production Settings (optional)
# -----------------------------------------------------------------------------
# Uncomment and configure as needed:

# Force HTTPS (when behind SSL-terminating proxy)
# WORDPRESS_CONFIG_EXTRA=define('FORCE_SSL_ADMIN', true);

# Disable file editing in WordPress admin
# WORDPRESS_CONFIG_EXTRA=define('DISALLOW_FILE_EDIT', true);

# Limit post revisions to save database space
# WORDPRESS_CONFIG_EXTRA=define('WP_POST_REVISIONS', 5);
