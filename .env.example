# WordPress AI Workspace Environment Configuration
# Copy this file to .env and customize the values
#
# FOR PRODUCTION: Use .env.production template instead!
#   cp .env.production .env
#   # Then change all CHANGE_ME values to secure passwords
#   # See: docs/PRODUCTION_SECURITY.md

# Database settings
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress

# Port settings
WP_PORT=8080
PMA_PORT=8081
ADMINER_PORT=8082
SFTP_PORT=2222

# WordPress settings
WP_DEBUG=false

# WordPress admin settings
# These will be used during initial setup
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_password
WP_ADMIN_EMAIL=admin@example.com

# Site settings
WP_SITE_TITLE="WordPress AI Workspace"
WP_SITE_URL=http://localhost:8080

# Optional: Specific WordPress version
# WP_VERSION=latest

# Optional: PHP settings
# PHP_MEMORY_LIMIT=256M
# PHP_UPLOAD_MAX_FILESIZE=64M
# PHP_POST_MAX_SIZE=64M
# PHP_MAX_EXECUTION_TIME=300

# Optional: Database backup settings
# BACKUP_RETENTION_DAYS=7

# Development Tool Versions (used when building custom containers)
COMPOSER_VERSION=2.7.1
WP_CLI_VERSION=2.11.0
WP_MCP_VERSION=0.2.3

# User/Group ID mapping for Docker (match your host user for file permissions)
USER_ID=1000
GROUP_ID=1000

# WordPress table prefix (must match imported database if restoring)
WORDPRESS_TABLE_PREFIX=wp_

# SFTP access password (change for production!)
SFTP_PASSWORD=wordpress